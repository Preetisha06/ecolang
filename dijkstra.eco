// Dijkstra shortest paths from node 0 (simple O(n^2) version)
// returns the sum of shortest distances from node 0

// builds the same test graph every time:
// edge between i and j if they are neighbours, or if (i*j + i + j) % 11 == 0
// weight of an edge is (i*j + i + j) % 9 + 1
fn build_graph(w: int[], n: int) -> int {
  let i: int = 0;
  while (i < n) {
    let j: int = 0;
    while (j < n) {
      let e: int = 0;
      if (i != j) {
        if ((i * j + i + j) % 11 == 0) {
          e = 1;
        }
        if (j == i + 1) {
          e = 1;
        }
        if (i == j + 1) {
          e = 1;
        }
      }
      if (e == 1) {
        w[i * n + j] = (i * j + i + j) % 9 + 1;
      } else {
        w[i * n + j] = 0;
      }
      j = j + 1;
    }
    i = i + 1;
  }
  return 0;
}

fn dijkstra(n: int) -> int {
  let w: int[n * n];
  build_graph(w, n);

  let dist: int[n];
  let done: int[n];
  let big: int = 1000000000;
  let i: int = 0;
  while (i < n) {
    dist[i] = big;
    done[i] = 0;
    i = i + 1;
  }
  dist[0] = 0;

  let round: int = 0;
  while (round < n) {
    // pick the closest node that is not done yet
    let u: int = -1;
    let best: int = big;
    i = 0;
    while (i < n) {
      if (done[i] == 0) {
        if (dist[i] < best) {
          best = dist[i];
          u = i;
        }
      }
      i = i + 1;
    }
    if (u == -1) {
      round = n;
    } else {
      done[u] = 1;
      // relax all its edges
      let v: int = 0;
      while (v < n) {
        let wt: int = w[u * n + v];
        if (wt != 0) {
          if (dist[u] + wt < dist[v]) {
            dist[v] = dist[u] + wt;
          }
        }
        v = v + 1;
      }
      round = round + 1;
    }
  }

  let sum: int = 0;
  i = 0;
  while (i < n) {
    sum = sum + dist[i];
    i = i + 1;
  }
  return sum;
}
