// bubble sort on n random numbers
// returns a checksum of the sorted array, or -1 if it is NOT sorted
fn bubble(n: int) -> int {
  let a: int[n];

  // fill with random numbers 0..999 (simple random generator)
  let seed: int = 42;
  let i: int = 0;
  while (i < n) {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    a[i] = seed % 1000;
    i = i + 1;
  }

  // bubble sort
  i = 0;
  while (i < n - 1) {
    let j: int = 0;
    while (j < n - 1 - i) {
      if (a[j] > a[j + 1]) {
        let tmp: int = a[j];
        a[j] = a[j + 1];
        a[j + 1] = tmp;
      }
      j = j + 1;
    }
    i = i + 1;
  }

  // check it is sorted, and make a checksum
  let sum: int = 0;
  i = 0;
  while (i < n) {
    if (i > 0) {
      if (a[i - 1] > a[i]) {
        return -1;
      }
    }
    sum = sum + a[i] * i;
    i = i + 1;
  }
  return sum;
}
