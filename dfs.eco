// depth-first search (recursive) from node 0 on an n-node graph
// returns  sum of (visit order x node number)  as a checksum

// builds the same test graph every time:
// edge between i and j if they are neighbours, or if (i*j + i + j) % 11 == 0
// weight of an edge is (i*j + i + j) % 9 + 1
fn build_graph(w: int[], n: int) -> int {
  let i: int = 0;
  while (i < n) {
    let j: int = 0;
    while (j < n) {
      let e: int = 0;
      if (i != j) {
        if ((i * j + i + j) % 11 == 0) {
          e = 1;
        }
        if (j == i + 1) {
          e = 1;
        }
        if (i == j + 1) {
          e = 1;
        }
      }
      if (e == 1) {
        w[i * n + j] = (i * j + i + j) % 9 + 1;
      } else {
        w[i * n + j] = 0;
      }
      j = j + 1;
    }
    i = i + 1;
  }
  return 0;
}

// counter[0] holds the next visit number
fn visit(w: int[], order: int[], counter: int[], n: int, u: int) -> int {
  order[u] = counter[0];
  counter[0] = counter[0] + 1;
  let v: int = 0;
  while (v < n) {
    if (w[u * n + v] != 0) {
      if (order[v] == -1) {
        visit(w, order, counter, n, v);
      }
    }
    v = v + 1;
  }
  return 0;
}

fn dfs(n: int) -> int {
  let w: int[n * n];
  build_graph(w, n);

  let order: int[n];
  let counter: int[1];
  let i: int = 0;
  while (i < n) {
    order[i] = -1;
    i = i + 1;
  }

  visit(w, order, counter, n, 0);

  let sum: int = 0;
  i = 0;
  while (i < n) {
    sum = sum + order[i] * i;
    i = i + 1;
  }
  return sum;
}
