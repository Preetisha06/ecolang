// quick sort on n random numbers
// returns a checksum of the sorted array, or -1 if it is NOT sorted

fn fill_random(a: int[], n: int) -> int {
  let seed: int = 42;
  let i: int = 0;
  while (i < n) {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    a[i] = seed % 1000;
    i = i + 1;
  }
  return 0;
}

fn checksum(a: int[], n: int) -> int {
  let sum: int = 0;
  let i: int = 0;
  while (i < n) {
    if (i > 0) {
      if (a[i - 1] > a[i]) {
        return -1;
      }
    }
    sum = sum + a[i] * i;
    i = i + 1;
  }
  return sum;
}

// sorts a[lo] ... a[hi]  (Lomuto partition, last element is the pivot)
fn quick_sort(a: int[], lo: int, hi: int) -> int {
  if (lo >= hi) {
    return 0;
  }
  let pivot: int = a[hi];
  let i: int = lo - 1;
  let j: int = lo;
  while (j < hi) {
    if (a[j] <= pivot) {
      i = i + 1;
      let swap: int = a[i];
      a[i] = a[j];
      a[j] = swap;
    }
    j = j + 1;
  }
  let last: int = a[i + 1];
  a[i + 1] = a[hi];
  a[hi] = last;

  quick_sort(a, lo, i);
  quick_sort(a, i + 2, hi);
  return 0;
}

fn quicksort(n: int) -> int {
  let a: int[n];
  fill_random(a, n);
  quick_sort(a, 0, n - 1);
  return checksum(a, n);
}
