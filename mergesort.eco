// merge sort on n random numbers
// returns a checksum of the sorted array, or -1 if it is NOT sorted

fn fill_random(a: int[], n: int) -> int {
  let seed: int = 42;
  let i: int = 0;
  while (i < n) {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    a[i] = seed % 1000;
    i = i + 1;
  }
  return 0;
}

fn checksum(a: int[], n: int) -> int {
  let sum: int = 0;
  let i: int = 0;
  while (i < n) {
    if (i > 0) {
      if (a[i - 1] > a[i]) {
        return -1;
      }
    }
    sum = sum + a[i] * i;
    i = i + 1;
  }
  return sum;
}

// sorts a[lo] ... a[hi - 1]
fn merge_sort(a: int[], tmp: int[], lo: int, hi: int) -> int {
  if (hi - lo < 2) {
    return 0;
  }
  let mid: int = (lo + hi) / 2;
  merge_sort(a, tmp, lo, mid);
  merge_sort(a, tmp, mid, hi);

  // merge the two sorted halves into tmp
  let i: int = lo;
  let j: int = mid;
  let k: int = lo;
  while (k < hi) {
    let take_left: int = 0;
    if (i < mid) {
      if (j >= hi) {
        take_left = 1;
      } else {
        if (a[i] <= a[j]) {
          take_left = 1;
        }
      }
    }
    if (take_left == 1) {
      tmp[k] = a[i];
      i = i + 1;
    } else {
      tmp[k] = a[j];
      j = j + 1;
    }
    k = k + 1;
  }

  // copy back
  k = lo;
  while (k < hi) {
    a[k] = tmp[k];
    k = k + 1;
  }
  return 0;
}

fn mergesort(n: int) -> int {
  let a: int[n];
  let tmp: int[n];
  fill_random(a, n);
  merge_sort(a, tmp, 0, n);
  return checksum(a, n);
}
