// a program with things the optimiser can clean up
fn compute(n: int) -> int {
  let total: int = 0;
  let i: int = 0;
  while (i < n) {
    let scale: int = 4 * 8;        // constant folding: becomes 32
    let unused: int = i * 100;     // dead code: nobody reads it
    let x: int = i * scale;        // propagation + strength reduction: i << 5
    total = total + x;
    i = i + 1;
  }
  return total;
}
